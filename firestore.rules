rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'; }
    function shared(col) { return col in ['sales','expenses','inventory','production','orders']; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow write: if isOwner();
    }

    match /{col}/{id} {
      // Admin (employee): daily-operation data. Only the owner may add or change a product's recipe.
      allow read: if signedIn() && shared(col);
      allow create: if signedIn() && shared(col)
        && (col != 'inventory' || !('recipe' in request.resource.data) || isOwner());
      allow update: if signedIn() && shared(col)
        && (col != 'inventory' || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['recipe']) || isOwner());
      allow delete: if isOwner() && shared(col);

      allow read: if signedIn() && col == 'machines';
      allow create, update, delete: if isOwner() && col in ['machines','payroll','employees','absences','advances'];
      allow read: if isOwner() && col in ['payroll','employees','absences','advances'];
    }

    // Cash remittances: a cashier can create and read their own; the owner reads and removes all.
    match /remittances/{id} {
      allow read: if isOwner() || (signedIn() && resource.data.cashierUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.cashierUid == request.auth.uid;
      allow delete: if isOwner();
    }
  }
}
